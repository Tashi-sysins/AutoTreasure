<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ゲーム無しで、本番のコードをそのまま試す。

    なぜプロジェクト参照ではないか:
      本体は Dalamud.NET.Sdk で建っているので、参照するとゲームが要る。

    なぜ書き直さないか:
      試験用に作り直すと「**偽物が通った**」だけになる。
      本番のファイルをそのまま取り込む。

    ⚠ ここに並ぶファイルを動かすと、この csproj も直す必要がある。
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>AutoTreasure.SyncTests</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 本番の合図の形。Dalamud に依存していないのでそのまま取り込める。 -->
    <Compile Include="..\..\AutoTreasure\Sync\SyncMessage.cs"
             Link="Production\SyncMessage.cs" />

    <!--
      封筒の形は、サーバーのプロジェクト参照から来る（同じ正本）。
      ここで重ねて取り込むと二重定義になるので入れない。
    -->

  </ItemGroup>

  <ItemGroup>
    <!--
      中継サーバーそのもの。権限判定（IsAllowedFromWorker）を試すため。

      ⚠ ここは Dalamud に依存していないので参照できる。
        プラグイン本体は Dalamud.NET.Sdk なので参照できない
        （だから上は Compile Include で取り込んでいる）。
    -->
    <ProjectReference Include="..\..\AutoTreasure.RelayServer\AutoTreasure.RelayServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
